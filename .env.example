# Next.js public values (Vercel project Root Directory: apps/web; install/build run from repository root).
NEXT_PUBLIC_CONTRACTS_JSON={"participants":"0x...","agreements":"0x...","events":"0x...","evidence":"0x...","consensus":"0x...","obligations":"0x..."}
NEXT_PUBLIC_GATEWAY_URL=https://your-fieldledger-gateway.workers.dev
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY= # Supply the Supabase publishable key (sb_publishable_...).

# Worker variables and secrets; set secrets with wrangler secret put.
GENLAYER_RPC=https://studio-dev.genlayer.com/api
CONTRACTS_JSON={"participants":"0x...","agreements":"0x...","events":"0x...","evidence":"0x...","consensus":"0x...","obligations":"0x..."}
CONTRACTS_ARCHIVE_JSON=[] # Optional JSON array of prior full maps; read-only historical verification.
ALLOWED_ORIGIN=https://your-app.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY= # Supply the Supabase publishable key (sb_publishable_...).
SUPABASE_SERVICE_ROLE_KEY= # Supply the Supabase secret key (sb_secret_...) as a Worker secret only.
ORGANISATION_HMAC_KEYS={"OP-WR":"long-random-key","MNT-SP":"independent-random-key"}
INTERNAL_CRON_TOKEN=
GATEWAY_URL=https://your-fieldledger-gateway.workers.dev
GATEWAY_BASE_URL=https://your-fieldledger-gateway.workers.dev/v1/evidence/

# Local signer values only. Never store these in Vercel or Cloudflare.
DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
CONTRACTOR_PRIVATE_KEY=
OEM_PRIVATE_KEY=
JV_PRIVATE_KEY=
INSPECTOR_PRIVATE_KEY=
OPERATOR_SIGNER=0x...
CONTRACTOR_SIGNER=0x...
OEM_SIGNER=0x...
JV_SIGNER=0x...
INSPECTOR_SIGNER=0x...

# Network-quoted bootstrap allocations; tune with Studio Dev and measured receipts.
FEE_LEADER_TIMEUNITS=100
FEE_VALIDATOR_TIMEUNITS=200
FEE_EXECUTION_BUDGET=25000000000000000
FEE_CHILD_MESSAGE_BUDGET=0
